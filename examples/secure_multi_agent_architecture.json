{
  "apiVersion": "interlock.dev/v1alpha1",
  "kind": "Architecture",
  "metadata": {
    "id": "customer-support-multi-agent",
    "version": "1.0.0"
  },
  "spec": {
    "trustZones": [
      {
        "id": "zone.external-input",
        "label": "External input",
        "kind": "EXTERNAL",
        "description": "Untrusted user and partner request sources",
        "bounds": {
          "x": 0,
          "y": 60,
          "width": 190,
          "height": 260
        }
      },
      {
        "id": "zone.control",
        "label": "Internal control plane",
        "kind": "INTERNAL",
        "description": "Coordinator, managed tools, and evidence services",
        "bounds": {
          "x": 220,
          "y": 0,
          "width": 420,
          "height": 520
        }
      },
      {
        "id": "zone.worker",
        "label": "Internal worker plane",
        "kind": "INTERNAL",
        "description": "Delegated agents and tenant-scoped retrieval",
        "bounds": {
          "x": 680,
          "y": 0,
          "width": 420,
          "height": 260
        }
      },
      {
        "id": "zone.external-output",
        "label": "External destinations",
        "kind": "EXTERNAL",
        "description": "Destinations outside the managed runtime",
        "bounds": {
          "x": 680,
          "y": 300,
          "width": 420,
          "height": 220
        }
      }
    ],
    "trustBoundaries": [
      {
        "id": "boundary.external-control-input",
        "label": "External request ingress",
        "sourceZoneId": "zone.external-input",
        "targetZoneId": "zone.control",
        "enforcementPoint": "INPUT_GATEWAY",
        "allowedRelationships": [
          "REQUESTS"
        ],
        "allowedDataClasses": [
          "D2",
          "D3"
        ],
        "deniedDataClasses": [
          "D5",
          "D8"
        ],
        "mode": "ENFORCE",
        "failureMode": "FAIL_CLOSED",
        "requireIdentity": true,
        "requireTenantBinding": true,
        "maxPayloadBytes": 262144
      },
      {
        "id": "boundary.control-worker-a2a",
        "label": "Control to worker A2A",
        "sourceZoneId": "zone.control",
        "targetZoneId": "zone.worker",
        "enforcementPoint": "A2A_BROKER",
        "allowedRelationships": [
          "DELEGATES"
        ],
        "allowedDataClasses": [
          "D2",
          "D3",
          "D7"
        ],
        "deniedDataClasses": [
          "D5",
          "D8"
        ],
        "mode": "ENFORCE",
        "failureMode": "FAIL_CLOSED",
        "requireIdentity": true,
        "requireTenantBinding": true,
        "maxPayloadBytes": 1048576
      },
      {
        "id": "boundary.control-external-egress",
        "label": "Approved external egress",
        "sourceZoneId": "zone.control",
        "targetZoneId": "zone.external-output",
        "enforcementPoint": "EGRESS_GATEWAY",
        "allowedRelationships": [
          "SENDS"
        ],
        "allowedDataClasses": [
          "D3",
          "D7"
        ],
        "deniedDataClasses": [
          "D5",
          "D8"
        ],
        "mode": "ENFORCE",
        "failureMode": "FAIL_CLOSED",
        "requireIdentity": true,
        "requireTenantBinding": true,
        "maxPayloadBytes": 1048576
      }
    ],
    "nodes": [
      {
        "id": "user.customer",
        "type": "USER",
        "owner": "customer-platform",
        "identity": "oidc://customer",
        "capabilities": [
          "SUPPORT_REQUEST"
        ],
        "dataAccess": [
          "D2",
          "D3"
        ],
        "trustZone": "EXTERNAL",
        "trustZoneId": "zone.external-input",
        "position": {
          "x": 30,
          "y": 120
        }
      },
      {
        "id": "agent.support",
        "type": "AGENT",
        "owner": "customer-platform",
        "identity": "spiffe://prod.example/agent/support",
        "capabilities": [
          "SUPPORT_REPLY",
          "DELEGATE_RESEARCH",
          "EMAIL_SEND"
        ],
        "dataAccess": [
          "D2",
          "D3",
          "D7"
        ],
        "maxDelegationDepth": 2,
        "trustZone": "INTERNAL",
        "trustZoneId": "zone.control",
        "position": {
          "x": 260,
          "y": 120
        }
      },
      {
        "id": "agent.research",
        "type": "SUBAGENT",
        "owner": "customer-platform",
        "identity": "spiffe://prod.example/agent/research",
        "capabilities": [
          "KNOWLEDGE_SEARCH"
        ],
        "dataAccess": [
          "D2",
          "D3",
          "D7"
        ],
        "maxDelegationDepth": 0,
        "trustZone": "INTERNAL",
        "trustZoneId": "zone.worker",
        "position": {
          "x": 720,
          "y": 20
        }
      },
      {
        "id": "rag.support-knowledge",
        "type": "RAG",
        "owner": "knowledge-platform",
        "identity": "spiffe://prod.example/rag/support",
        "capabilities": [
          "TENANT_RETRIEVAL"
        ],
        "dataAccess": [
          "D2",
          "D3",
          "D7"
        ],
        "sideEffects": [
          "READ"
        ],
        "trustZone": "INTERNAL",
        "trustZoneId": "zone.worker",
        "position": {
          "x": 920,
          "y": 20
        }
      },
      {
        "id": "tool.send-email",
        "type": "TOOL",
        "owner": "messaging-platform",
        "identity": "spiffe://prod.example/tool/send-email",
        "capabilities": [
          "EMAIL_SEND"
        ],
        "dataAccess": [
          "D2",
          "D3",
          "D7"
        ],
        "sideEffects": [
          "EXTERNAL_WRITE"
        ],
        "definitionDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "trustZone": "INTERNAL",
        "trustZoneId": "zone.control",
        "position": {
          "x": 450,
          "y": 220
        }
      },
      {
        "id": "external.customer-email",
        "type": "EXTERNAL",
        "owner": "messaging-platform",
        "identity": "dns://customer.example",
        "allowedDomains": [
          "customer.example"
        ],
        "dataAccess": [
          "D3",
          "D7"
        ],
        "trustZone": "EXTERNAL",
        "trustZoneId": "zone.external-output",
        "position": {
          "x": 920,
          "y": 360
        }
      },
      {
        "id": "external.audit-ledger",
        "type": "EXTERNAL",
        "owner": "security-platform",
        "identity": "spiffe://prod.example/interlock/ledger",
        "dataAccess": [
          "D2",
          "D3",
          "D7"
        ],
        "trustZone": "INTERNAL",
        "trustZoneId": "zone.control",
        "position": {
          "x": 450,
          "y": 390
        }
      }
    ],
    "edges": [
      {
        "id": "edge.user-support",
        "relationshipId": "REL-01",
        "source": "user.customer",
        "target": "agent.support",
        "relationship": "REQUESTS",
        "boundaryId": "boundary.external-control-input",
        "policy": {
          "id": "customer-support-input",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedPurposes": [
            "SUPPORT_REQUEST"
          ],
          "allowedDataClasses": [
            "D2",
            "D3"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "failureMode": "FAIL_CLOSED"
        },
        "controls": [
          {
            "id": "input-identity-and-taint",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "INPUT_GATEWAY",
            "assurance": "ENFORCED"
          },
          {
            "id": "input-audit",
            "objective": "EVIDENCE",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "OBSERVED"
          }
        ]
      },
      {
        "id": "edge.support-research",
        "relationshipId": "REL-06",
        "source": "agent.support",
        "target": "agent.research",
        "relationship": "DELEGATES",
        "boundaryId": "boundary.control-worker-a2a",
        "dynamic": true,
        "targetSelector": {
          "types": [
            "SUBAGENT"
          ],
          "requiredCapabilities": [
            "KNOWLEDGE_SEARCH"
          ],
          "idPattern": "agent.research*",
          "sameTenant": true
        },
        "policy": {
          "id": "support-research-delegation",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedPurposes": [
            "SUPPORT_RESEARCH"
          ],
          "allowedDataClasses": [
            "D2",
            "D3",
            "D7"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "requireAudience": true,
          "requireResource": true,
          "requireActorBinding": true,
          "maxDelegationDepth": 2,
          "failureMode": "FAIL_CLOSED"
        },
        "controls": [
          {
            "id": "delegation-binding",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "A2A_BROKER",
            "assurance": "ENFORCED"
          },
          {
            "id": "delegation-audit",
            "objective": "EVIDENCE",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "OBSERVED"
          }
        ]
      },
      {
        "id": "edge.research-rag",
        "relationshipId": "REL-03",
        "source": "agent.research",
        "target": "rag.support-knowledge",
        "relationship": "READS",
        "policy": {
          "id": "tenant-rag-read",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedPurposes": [
            "SUPPORT_RESEARCH"
          ],
          "allowedDataClasses": [
            "D2",
            "D3",
            "D7"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "failureMode": "FAIL_CLOSED"
        },
        "controls": [
          {
            "id": "rag-tenant-acl-and-secret-scan",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "RAG_GATEWAY",
            "assurance": "ENFORCED"
          },
          {
            "id": "rag-provenance-audit",
            "objective": "EVIDENCE",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "OBSERVED"
          }
        ]
      },
      {
        "id": "edge.support-email-tool",
        "relationshipId": "REL-05",
        "source": "agent.support",
        "target": "tool.send-email",
        "relationship": "INVOKES",
        "policy": {
          "id": "support-email-invoke",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedPurposes": [
            "SUPPORT_REPLY"
          ],
          "allowedDataClasses": [
            "D2",
            "D3",
            "D7"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "requireActiveDefinition": true,
          "requireDigestPin": true,
          "failureMode": "FAIL_CLOSED"
        },
        "controls": [
          {
            "id": "mcp-definition-and-call-guard",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "MCP_GATEWAY",
            "assurance": "ENFORCED"
          },
          {
            "id": "stdio-process-sandbox",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "SANDBOX",
            "assurance": "ENFORCED",
            "description": "Pinned process profile with filesystem, network, and child-process isolation attestation"
          },
          {
            "id": "mcp-audit",
            "objective": "EVIDENCE",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "OBSERVED"
          }
        ]
      },
      {
        "id": "edge.email-customer",
        "relationshipId": "REL-07",
        "source": "tool.send-email",
        "target": "external.customer-email",
        "relationship": "SENDS",
        "boundaryId": "boundary.control-external-egress",
        "policy": {
          "id": "customer-email-egress",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedPurposes": [
            "SUPPORT_REPLY"
          ],
          "allowedDataClasses": [
            "D3",
            "D7"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "requireExplicitDestination": true,
          "newDestinationAction": "HOLD",
          "externalWriteRequiresApproval": true,
          "failureMode": "FAIL_CLOSED"
        },
        "controls": [
          {
            "id": "egress-dlp-and-destination",
            "objective": "PREVENT",
            "timing": "PRE_EXECUTION",
            "enforcementPoint": "EGRESS_GATEWAY",
            "assurance": "ENFORCED"
          },
          {
            "id": "egress-receipt-reconciliation",
            "objective": "DETECT",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "RECONCILED"
          }
        ]
      },
      {
        "id": "edge.support-audit",
        "relationshipId": "REL-12",
        "source": "agent.support",
        "target": "external.audit-ledger",
        "relationship": "LOGS_TO",
        "policy": {
          "id": "mandatory-audit",
          "version": "1.0.0",
          "mode": "ENFORCE",
          "allowedDataClasses": [
            "D2",
            "D3",
            "D7"
          ],
          "deniedDataClasses": [
            "D5",
            "D8"
          ],
          "failureMode": "DEGRADE_READ_ONLY"
        },
        "controls": [
          {
            "id": "append-only-audit",
            "objective": "EVIDENCE",
            "timing": "POST_EXECUTION",
            "enforcementPoint": "AUDIT_SINK",
            "assurance": "RECONCILED"
          }
        ]
      }
    ],
    "orchestration": {
      "coordinatorActorId": "agent.support",
      "pattern": "HYBRID",
      "runPolicy": {
        "maxParallelism": 4,
        "maxTasks": 50,
        "maxDurationSeconds": 1800,
        "maxMessages": 200,
        "failFast": true
      },
      "tasks": [
        {
          "id": "task.research",
          "label": "Research the support request",
          "sourceActorId": "agent.support",
          "targetActorId": "agent.research",
          "transport": "A2A",
          "purpose": "SUPPORT_RESEARCH",
          "dataClasses": [
            "D2",
            "D3",
            "D7"
          ],
          "acceptanceCriteria": [
            "nonempty:artifacts"
          ],
          "maxAttempts": 2,
          "timeoutSeconds": 120,
          "onFailure": "FAIL_WORKFLOW",
          "position": {
            "x": 120,
            "y": 120
          }
        },
        {
          "id": "task.send-reply",
          "label": "Send the approved support reply",
          "sourceActorId": "agent.support",
          "targetActorId": "tool.send-email",
          "transport": "MCP",
          "purpose": "SUPPORT_REPLY",
          "dependsOn": [
            "task.research"
          ],
          "dataClasses": [
            "D3",
            "D7"
          ],
          "acceptanceCriteria": [
            "required:receiptId"
          ],
          "maxAttempts": 1,
          "timeoutSeconds": 60,
          "approvalRequired": true,
          "onFailure": "FAIL_WORKFLOW",
          "position": {
            "x": 440,
            "y": 120
          }
        }
      ]
    }
  }
}
