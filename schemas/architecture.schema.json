{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlock.dev/schemas/architecture.schema.json",
  "title": "Agent Interlock Security Architecture",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "interlock.dev/v1alpha1"},
    "kind": {"const": "Architecture"},
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["id", "objective", "timing", "enforcementPoint", "assurance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"enum": ["PREVENT", "DETECT", "RESPOND", "EVIDENCE"]},
        "timing": {"enum": ["DESIGN", "ADMISSION", "PRE_EXECUTION", "EXECUTION", "POST_EXECUTION"]},
        "enforcementPoint": {
          "enum": [
            "DESIGN_LINTER", "SDK", "INPUT_GATEWAY", "MODEL_ROUTER", "RAG_GATEWAY",
            "MCP_GATEWAY", "A2A_BROKER", "MEMORY_STORE", "EGRESS_GATEWAY",
            "APPROVAL_GATE", "TRIGGER_VALIDATOR", "STATE_MACHINE", "SANDBOX",
            "DEPLOY_GATE", "AUDIT_SINK", "RESPONSE_ORCHESTRATOR"
          ]
        },
        "assurance": {"enum": ["DECLARED", "OBSERVED", "ENFORCED", "RECONCILED"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "owner", "identity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["USER", "AGENT", "SUBAGENT", "TOOL", "RAG", "MEMORY", "SCHEDULER", "EXTERNAL"]},
        "owner": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dataAccess": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sideEffects": {"type": "array", "items": {"enum": ["NONE", "READ", "INTERNAL_WRITE", "EXTERNAL_WRITE", "DESTRUCTIVE_WRITE", "PAYMENT", "PERMISSION_CHANGE"]}, "uniqueItems": true},
        "inputSchema": {"type": "object"},
        "outputSchema": {"type": "object"},
        "tenantMode": {"enum": ["REQUIRED", "OPTIONAL", "GLOBAL"]},
        "failureMode": {"enum": ["FAIL_OPEN", "FAIL_CLOSED", "DEGRADE_READ_ONLY"]},
        "allowedDomains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "maxDelegationDepth": {"type": "integer", "minimum": 0},
        "definitionDigest": {"type": ["string", "null"]},
        "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "mode": {"enum": ["OBSERVE", "SHADOW", "ENFORCE"]},
        "allowedPurposes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowedDataClasses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deniedDataClasses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requireActiveDefinition": {"type": "boolean"},
        "requireDigestPin": {"type": "boolean"},
        "requireExplicitDestination": {"type": "boolean"},
        "newDestinationAction": {"enum": ["ALLOW", "BLOCK", "HOLD", "QUARANTINE"]},
        "tokenPassthrough": {"type": "boolean"},
        "requireAudience": {"type": "boolean"},
        "requireResource": {"type": "boolean"},
        "requireActorBinding": {"type": "boolean"},
        "maxDelegationDepth": {"type": "integer", "minimum": 0},
        "externalWriteRequiresApproval": {"type": "boolean"},
        "failureMode": {"enum": ["FAIL_OPEN", "FAIL_CLOSED", "DEGRADE_READ_ONLY"]},
        "decisionTtlSeconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "relationshipId", "source", "target", "relationship", "policy", "controls"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "relationshipId": {"type": "string", "pattern": "^REL-[0-9]{2}$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "relationship": {"enum": ["REQUESTS", "DELEGATES", "INVOKES", "READS", "WRITES", "SENDS", "APPROVES", "AUTHENTICATES_AS", "ROUTES", "EXECUTES_ON", "DEPLOYS_TO", "LOGS_TO", "RETURNS_TO"]},
        "dynamic": {"type": "boolean"},
        "targetSelector": {
          "type": "object",
          "required": ["types", "requiredCapabilities", "idPattern", "sameTenant"],
          "properties": {
            "types": {
              "type": "array",
              "minItems": 1,
              "items": {"enum": ["AGENT", "SUBAGENT", "TOOL", "RAG", "MEMORY", "EXTERNAL"]},
              "uniqueItems": true
            },
            "requiredCapabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "idPattern": {"type": "string", "minLength": 1},
            "sameTenant": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "policy": {"$ref": "#/$defs/policy"},
        "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}}
      },
      "allOf": [
        {
          "if": {"properties": {"dynamic": {"const": true}}, "required": ["dynamic"]},
          "then": {"required": ["targetSelector"]},
          "else": {"not": {"required": ["targetSelector"]}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
